# Copie para .env e preencha. Nunca suba o .env.
BOARD_PASSWORD=troque-esta-senha
# Opcional: segredo dos cookies de login (se vazio, gera um a cada início e todos precisam logar de novo)
BOARD_SECRET=
PORT=8830
# Em quais IPs escutar (padrão 127.0.0.1; use um proxy com HTTPS na frente, ex.: Caddy)
BIND=127.0.0.1
# Serviços do systemd mostrados na aba VPS do Dashboard
CB_SERVICES=claude-board,docker
# Nomes próprios que ajudam a transcrição de voz (separados por vírgula)
CB_STT_TERMS=Claude,Claude Code,Opus,Sonnet,Haiku
# Caminho do Claude Code CLI, se não estiver no PATH padrão
CLAUDE_BIN=
